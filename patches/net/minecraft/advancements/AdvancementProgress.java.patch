+    // Youer start - deep copy for the asynchronous advancement save
+    // The worker thread encodes this snapshot while the main thread keeps mutating the live progress
+    // (award/revoke), so the copy must not share any mutable state. AdvancementRequirements is a
+    // record and can be shared; the codec only reads criteria and isDone().
+    public AdvancementProgress snapshot() {
+        Map<String, CriterionProgress> copy = new HashMap<>(this.criteria.size());
+        this.criteria.forEach((criterion, criterionprogress) -> {
+            java.time.Instant obtained = criterionprogress.getObtained();
+            copy.put(criterion, obtained == null ? new CriterionProgress() : new CriterionProgress(obtained));
+        });
+        AdvancementProgress advancementprogress = new AdvancementProgress(copy);
+        advancementprogress.requirements = this.requirements;
+        return advancementprogress;
+    }
+    // Youer end
